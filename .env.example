# Copy to .env (git-ignored) and fill in. Read by the Makefile and exported to
# `uv publish`, which picks these up natively. Plain KEY=value lines only: make
# does not strip quotes.

# Upload endpoint of the package index. Required by `make publish`; without it
# uv would default to the public PyPI.
UV_PUBLISH_URL=

# Optional: the index's simple API, so re-running a publish skips files that
# are already uploaded instead of failing.
# UV_PUBLISH_CHECK_URL=

# Credentials. Better set in your shell or a credential helper than stored here.
# UV_PUBLISH_USERNAME=
# UV_PUBLISH_PASSWORD=
